# ---- Application ----
# One port serves both the Next.js pages and the /api routes.
#
# Set this to production for any container or deployed run. It is not cosmetic:
# server.js starts Next in dev mode whenever this is not "production", so a
# production image still runs the dev server and ignores the bundle it built -
# and the session cookie loses its Secure flag.
NODE_ENV=development
PORT=3000
HOSTNAME=localhost

# ---- MongoDB ----
# Used by docker compose to initialise the mongo container.
MONGO_INITDB_ROOT_USERNAME=mongoadmin
MONGO_INITDB_ROOT_PASSWORD=mongopassword
MONGODB_LOCAL_PORT=27017
MONGODB_DOCKER_PORT=27017

# The only connection setting the application itself reads.
# Running under docker compose, the host is the `mongodb` service name.
MONGO_URL=mongodb://mongoadmin:mongopassword@mongodb:27017/moderntodo?authSource=admin
# Running the app on the host against a local mongo, use:
# MONGO_URL=mongodb://mongoadmin:mongopassword@localhost:27017/moderntodo?authSource=admin

# ---- Auth ----
# Tokens are signed with this. The server refuses to start if it is shorter than
# 32 characters or still says "change-me", so generate a real one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-secret

# ---- Proxies ----
# How many reverse proxies sit in front of the app (nginx, Traefik, a load
# balancer). 0 means it is reached directly and X-Forwarded-For is ignored.
# Set this to the real number or the rate limiter keys every request to the
# proxy's address and one user's failed logins lock out everybody.
TRUST_PROXY_HOPS=0

# ---- Plans ----
# Billing is not wired up, so changing the storage plan is disabled by default.
# Set to true in development to re-enable the selector on the Files page.
ALLOW_SELF_SERVE_TIERS=false

# ---- PDF renderer ----
# The Rust service binds 127.0.0.1 only; this key is how the app authenticates
# to it. At least 16 characters, or the renderer refuses to start.
PDF_SERVICE_KEY=change-me-to-a-long-random-internal-key
# Spawned as a child of server.js by default. Set to 0 to run it as its own
# container and point PDF_SERVICE_URL at it instead.
PDF_SERVICE_SPAWN=1
# PDF_SERVICE_URL=http://pdf:8787
