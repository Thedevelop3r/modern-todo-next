# ---- Application ----
# One port serves both the Next.js pages and the /api routes.
NODE_ENV=development
PORT=3000
HOSTNAME=localhost

# ---- MongoDB ----
# Used by docker compose to initialise the mongo container.
MONGO_INITDB_ROOT_USERNAME=mongoadmin
MONGO_INITDB_ROOT_PASSWORD=mongopassword
MONGODB_LOCAL_PORT=27017
MONGODB_DOCKER_PORT=27017

# The only connection setting the application itself reads.
# Running under docker compose, the host is the `mongodb` service name.
MONGO_URL=mongodb://mongoadmin:mongopassword@mongodb:27017/moderntodo?authSource=admin
# Running the app on the host against a local mongo, use:
# MONGO_URL=mongodb://mongoadmin:mongopassword@localhost:27017/moderntodo?authSource=admin

# ---- Auth ----
# Replace with a long random value. Tokens are signed with this.
JWT_SECRET=change-me-to-a-long-random-secret

# ---- PDF renderer ----
# The Rust service binds 127.0.0.1 only; this key is how the app authenticates
# to it. At least 16 characters, or the renderer refuses to start.
PDF_SERVICE_KEY=change-me-to-a-long-random-internal-key
# Spawned as a child of server.js by default. Set to 0 to run it as its own
# container and point PDF_SERVICE_URL at it instead.
PDF_SERVICE_SPAWN=1
# PDF_SERVICE_URL=http://pdf:8787
