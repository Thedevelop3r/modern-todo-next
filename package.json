{
  "name": "modern-todo",
  "version": "1.0.0",
  "private": true,
  "description": "Modern Todo \u2014 Next.js frontend and Express API served together from one custom server",
  "author": "Bilal Amjad",
  "developer-github": "www.github.com/thedevelop3r",
  "username": "@thedevelop3r",
  "license": "MIT",
  "main": "server.js",
  "scripts": {
    "dev": "node server.js",
    "build": "next build",
    "start": "cross-env NODE_ENV=production node server.js",
    "lint": "next lint",
    "test": "npm run test:api && npm run test:web",
    "test:watch": "node --test --watch \"server/__tests__/**/*.test.js\"",
    "test:api": "node --test \"server/__tests__/**/*.test.js\"",
    "test:web": "node --test \"src/__tests__/**/*.test.ts\"",
    "icons": "node scripts/generate-icons.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "^5.102.8",
    "bcrypt": "^5.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cookie-parser": "^1.4.6",
    "date-fns": "^4.4.0",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.0",
    "framer-motion": "^13.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.42.0",
    "mongoose": "^8.0.3",
    "next": "14.0.4",
    "next-themes": "^0.4.6",
    "react": "^18",
    "react-dom": "^18",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "cross-env": "^7.0.3",
    "eslint": "8.56.0",
    "eslint-config-next": "14.0.4",
    "mongodb-memory-server": "^11.2.0",
    "postcss": "^8",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.3.0",
    "typescript": "^5"
  },
  "allowScripts": {
    "bcrypt@5.1.1": true
  }
}
